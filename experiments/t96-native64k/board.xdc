# From T104 physical/board_pins.xdc at 8ce9104462d34f6d7daede73b3346e6dfa91f19a.
# Proposed adapter net assignment from verified ZedBoard XDC and SRAM TSOP.
# Net names are not a claim of an existing manufactured adapter.
set_property PACKAGE_PIN Y9 [get_ports ref100]
set_property IOSTANDARD LVCMOS33 [get_ports ref100]
set_property PACKAGE_PIN A22 [get_ports {sram_a[0]}]
set_property PACKAGE_PIN M19 [get_ports {sram_a[1]}]
set_property PACKAGE_PIN N20 [get_ports {sram_a[2]}]
set_property PACKAGE_PIN N19 [get_ports {sram_a[3]}]
set_property PACKAGE_PIN P18 [get_ports {sram_a[4]}]
set_property PACKAGE_PIN P17 [get_ports {sram_a[5]}]
set_property PACKAGE_PIN P22 [get_ports {sram_a[6]}]
set_property PACKAGE_PIN N22 [get_ports {sram_a[7]}]
set_property PACKAGE_PIN M22 [get_ports {sram_a[8]}]
set_property PACKAGE_PIN M21 [get_ports {sram_a[9]}]
set_property PACKAGE_PIN K18 [get_ports {sram_a[10]}]
set_property PACKAGE_PIN J18 [get_ports {sram_a[11]}]
set_property PACKAGE_PIN L22 [get_ports {sram_a[12]}]
set_property PACKAGE_PIN L21 [get_ports {sram_a[13]}]
set_property PACKAGE_PIN T17 [get_ports {sram_a[14]}]
set_property PACKAGE_PIN T16 [get_ports {sram_a[15]}]
set_property PACKAGE_PIN J22 [get_ports {sram_a[16]}]
set_property PACKAGE_PIN J21 [get_ports {sram_a[17]}]
set_property PACKAGE_PIN R21 [get_ports {sram_a[18]}]
set_property PACKAGE_PIN R20 [get_ports {sram_a[19]}]
set_property PACKAGE_PIN B20 [get_ports {sram_dq[0]}]
set_property PACKAGE_PIN B19 [get_ports {sram_dq[1]}]
set_property PACKAGE_PIN C20 [get_ports {sram_dq[2]}]
set_property PACKAGE_PIN D20 [get_ports {sram_dq[3]}]
set_property PACKAGE_PIN G16 [get_ports {sram_dq[4]}]
set_property PACKAGE_PIN G15 [get_ports {sram_dq[5]}]
set_property PACKAGE_PIN G21 [get_ports {sram_dq[6]}]
set_property PACKAGE_PIN G20 [get_ports {sram_dq[7]}]
set_property PACKAGE_PIN E20 [get_ports {sram_dq[8]}]
set_property PACKAGE_PIN E19 [get_ports {sram_dq[9]}]
set_property PACKAGE_PIN F19 [get_ports {sram_dq[10]}]
set_property PACKAGE_PIN G19 [get_ports {sram_dq[11]}]
set_property PACKAGE_PIN D15 [get_ports {sram_dq[12]}]
set_property PACKAGE_PIN E15 [get_ports {sram_dq[13]}]
set_property PACKAGE_PIN A19 [get_ports {sram_dq[14]}]
set_property PACKAGE_PIN A18 [get_ports {sram_dq[15]}]
set_property PACKAGE_PIN C22 [get_ports {sram_ce_n}]
set_property PACKAGE_PIN D22 [get_ports {sram_oe_n}]
set_property PACKAGE_PIN E18 [get_ports {sram_we_n}]
set_property PACKAGE_PIN F18 [get_ports {sram_lb_n}]
set_property PACKAGE_PIN D21 [get_ports {sram_ub_n}]
set_property PACKAGE_PIN E21 [get_ports {sram_err}]
set_property IOSTANDARD LVCMOS33 [get_ports {sram_a[*] sram_dq[*] sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n sram_err}]
set_property DRIVE 8 [get_ports {sram_a[*] sram_dq[*] sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n}]
set_property SLEW FAST [get_ports {sram_a[*] sram_dq[*] sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n}]
set_load 15 [get_ports {sram_a[*] sram_dq[*] sram_ce_n sram_oe_n sram_we_n sram_lb_n sram_ub_n}]
set_property PACKAGE_PIN T22 [get_ports locked_led]
set_property PACKAGE_PIN T21 [get_ports fault_led]
set_property IOSTANDARD LVCMOS33 [get_ports {locked_led fault_led}]
set_property DRIVE 8 [get_ports {locked_led fault_led}]
set_property SLEW SLOW [get_ports {locked_led fault_led}]

create_clock -name ref100 -period 10 [get_ports ref100]
set_clock_uncertainty -setup 0.5 [get_clocks ref100]
set_clock_uncertainty -hold 0.1 [get_clocks ref100]
set_output_delay -clock ref100 -max 5 [get_ports {locked_led fault_led}]
set_output_delay -clock ref100 -min 0 [get_ports {locked_led fault_led}]
set_load 5 [get_ports {locked_led fault_led}]
